# Public site URL, used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (optional in Milestone 1).
# When these are empty the app runs in guest mode with on-device persistence.
# Only the URL and the anon/publishable key are ever sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the client and never commit a real value.
# Reserved for admin/maintenance tasks (account deletion, exports) in later milestones.
SUPABASE_SERVICE_ROLE_KEY=
